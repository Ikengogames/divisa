{
  "name": "divisa",
  "version": "0.2.0",
  "description": "Divisa design system: palette, stili e componenti per siti di sport e giochi (Next.js + Tailwind).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ikengogames/divisa.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/components/index.ts",
    "./tailwind": {
      "types": "./tailwind.preset.d.ts",
      "default": "./tailwind.preset.js"
    },
    "./styles.css": "./styles/base.css",
    "./games.css": "./styles/giochi.css"
  },
  "files": [
    "src",
    "styles",
    "example",
    "tailwind.preset.js",
    "tailwind.preset.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "example": "tailwindcss -c example/tailwind.config.mjs -i example/input.css -o example/out.css"
  },
  "peerDependencies": {
    "react": ">=18.3.0",
    "tailwindcss": "^3.4.0",
    "next-auth": "^4.24.0"
  },
  "peerDependenciesMeta": {
    "next-auth": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "next-auth": "^4.24.15",
    "react": "^19.3.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  },
  "keywords": [
    "design-system",
    "tailwind",
    "nextjs",
    "sport",
    "games"
  ]
}
